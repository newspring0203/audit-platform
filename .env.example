# 키 값은 이 파일에 넣지 마세요. .env에 로컬로만 설정합니다.
# DART 키는 40자리입니다.
DART_API_KEY=
# AI를 사용하지 않으면 아래는 비워둡니다.
OPENAI_API_KEY=
# Responses API의 구조화 출력을 지원하고 본인 계정에서 사용 가능한 모델 ID
OPENAI_MODEL=

# AUDIT_* settings are process/hosting environment variables, not read from local .env.
# Local defaults: AUDIT_MODE=local, loopback listener via scripts/run_local.py.
# Deployment: AUDIT_MODE=demo or private; HTTPS origin is mandatory.
# AUDIT_MODE=demo
# AUDIT_PUBLIC_ORIGIN=https://your-app.example.com
# AUDIT_RUNTIME_ROOT=/tmp/audit-platform
# AUDIT_JOB_TTL_SECONDS=3600
# AUDIT_MAX_JOBS_TOTAL=20
# AUDIT_ANALYSIS_WORKERS=1
# PORT=8000
